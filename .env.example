# Session encryption (generate: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Super admin credentials (created on first migration if no users exist)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=ChangeMe123!

# SQLite database path (relative to project root)
DATABASE_PATH=./data/clinic.db
